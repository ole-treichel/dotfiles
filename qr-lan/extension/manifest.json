{
  "manifest_version": 3,
  "name": "QR-LAN",
  "version": "0.1.0",
  "description": "Scan the current tab from your phone, with loopback hosts rewritten to this machine's LAN IP.",
  "browser_specific_settings": {
    "gecko": {
      "id": "qr-lan@pixelwerte.de",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["activeTab"],
  "action": {
    "default_title": "QR-LAN",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Show a QR code for the current tab"
    }
  }
}
