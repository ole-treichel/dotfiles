{
    "manifest_version": 2,
    "name": "Oxide",
    "version": "1.0.0",
    "description": "Oxide light and dark. Follows the system color-scheme via dark_theme. Palette: oxide/colors.txt in the dotfiles repo.",
    "browser_specific_settings": {
        "gecko": {
            "id": "oxide@theme-cli"
        }
    },
    "theme": {
        "colors": {
            "frame": "#e4e4e4",
            "frame_inactive": "#e4e4e4",
            "tab_background_text": "#777777",
            "tab_text": "#1b1b1b",
            "tab_selected": "#f5f5f5",
            "tab_line": "#f5f5f5",
            "tab_loading": "#4d4d4d",
            "tab_background_separator": "#c4c4c4",
            "toolbar": "#f5f5f5",
            "toolbar_text": "#333333",
            "icons": "#333333",
            "toolbar_top_separator": "#e4e4e4",
            "toolbar_bottom_separator": "#d4d4d4",
            "toolbar_vertical_separator": "#c4c4c4",
            "toolbar_field": "#eeeeee",
            "toolbar_field_focus": "#eeeeee",
            "toolbar_field_text": "#333333",
            "toolbar_field_text_focus": "#1b1b1b",
            "toolbar_field_border": "#d4d4d4",
            "toolbar_field_border_focus": "#777777",
            "toolbar_field_highlight": "#c4c4c4",
            "toolbar_field_highlight_text": "#1b1b1b",
            "button_background_hover": "#d4d4d4",
            "button_background_active": "#c4c4c4",
            "popup": "#f5f5f5",
            "popup_text": "#333333",
            "popup_border": "#c4c4c4",
            "popup_highlight": "#d4d4d4",
            "popup_highlight_text": "#1b1b1b",
            "sidebar": "#f5f5f5",
            "sidebar_text": "#333333",
            "sidebar_border": "#c4c4c4",
            "sidebar_highlight": "#d4d4d4",
            "sidebar_highlight_text": "#1b1b1b",
            "ntp_background": "#f5f5f5",
            "ntp_text": "#333333",
            "ntp_card_background": "#e4e4e4"
        }
    },
    "dark_theme": {
        "colors": {
            "frame": "#121212",
            "frame_inactive": "#121212",
            "tab_background_text": "#808080",
            "tab_text": "#eeeeee",
            "tab_selected": "#222222",
            "tab_line": "#222222",
            "tab_loading": "#aeaeae",
            "tab_background_separator": "#3a3a3a",
            "toolbar": "#222222",
            "toolbar_text": "#cecece",
            "icons": "#cecece",
            "toolbar_top_separator": "#121212",
            "toolbar_bottom_separator": "#2e2e2e",
            "toolbar_vertical_separator": "#3a3a3a",
            "toolbar_field": "#161616",
            "toolbar_field_focus": "#161616",
            "toolbar_field_text": "#cecece",
            "toolbar_field_text_focus": "#eeeeee",
            "toolbar_field_border": "#2e2e2e",
            "toolbar_field_border_focus": "#808080",
            "toolbar_field_highlight": "#3a3a3a",
            "toolbar_field_highlight_text": "#eeeeee",
            "button_background_hover": "#2e2e2e",
            "button_background_active": "#3a3a3a",
            "popup": "#222222",
            "popup_text": "#cecece",
            "popup_border": "#3a3a3a",
            "popup_highlight": "#2e2e2e",
            "popup_highlight_text": "#eeeeee",
            "sidebar": "#161616",
            "sidebar_text": "#cecece",
            "sidebar_border": "#3a3a3a",
            "sidebar_highlight": "#2e2e2e",
            "sidebar_highlight_text": "#eeeeee",
            "ntp_background": "#161616",
            "ntp_text": "#cecece",
            "ntp_card_background": "#222222"
        }
    }
}
